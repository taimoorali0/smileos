{
  "name": "smileos-desktop",
  "productName": "SmileOS",
  "version": "1.0.0",
  "description": "SmileOS desktop app: opens your SmileOS server and launches imaging and other bridged programs",
  "main": "main.js",
  "author": "SmileOS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "icons": "node make-icons.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.smileos.desktop",
    "productName": "SmileOS",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SmileOS"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}